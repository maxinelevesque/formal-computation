import FormalComputation.SKI.Weight

/-!
# SKI: elementary squares and the two kinds of divergence (PROOF_MAP K5, K6, K7, K8)

`Sq` lists generating equations between reductions: interchange of disjoint redexes and
naturality of each rule in each argument, closed under contexts and whiskering. `PermEq` is
the equivalence relation they generate.

K6–K8 are about `PermEq` as defined here. Whether it coincides with Lévy's permutation
equivalence is not checked in Lean (PROOF_MAP hazard "K5"); the post depends on it only for
the interpretation.
-/

namespace FormalComputation.SKI

/-- **K5.** Elementary squares. -/
inductive Sq : {t u : Tm} → Red t u → Red t u → Prop
  /-- Disjoint redexes commute. -/
  | disjoint {t t' u u' : Tm} (a : Step t t') (b : Step u u') :
      Sq (r2 (.appL u a) (.appR t' b)) (r2 (.appR t b) (.appL u' a))
  /-- Naturality of the I-rule. -/
  | i_nat {x x' : Tm} (a : Step x x') :
      Sq (r2 (.appR .I a) (.i x')) (r2 (.i x) a)
  /-- Naturality of the K-rule in its first argument. -/
  | k_nat₁ {x x' : Tm} (a : Step x x') (y : Tm) :
      Sq (r2 (.appL y (.appR .K a)) (.k x' y)) (r2 (.k x y) a)
  /-- Naturality of the K-rule in its second argument (which it erases). -/
  | k_nat₂ (x : Tm) {y y' : Tm} (b : Step y y') :
      Sq (r2 (.appR (.K ⬝ x) b) (.k x y')) (r1 (.k x y))
  /-- Naturality of the S-rule in its first argument. -/
  | s_nat₁ {x x' : Tm} (a : Step x x') (y z : Tm) :
      Sq (r2 (.appL z (.appL y (.appR .S a))) (.s x' y z))
         (r2 (.s x y z) (.appL (y ⬝ z) (.appL z a)))
  /-- Naturality of the S-rule in its second argument. -/
  | s_nat₂ (x : Tm) {y y' : Tm} (b : Step y y') (z : Tm) :
      Sq (r2 (.appL z (.appR (.S ⬝ x) b)) (.s x y' z))
         (r2 (.s x y z) (.appR (x ⬝ z) (.appL z b)))
  /-- Naturality of the S-rule in its third argument (which it duplicates). -/
  | s_nat₃ (x y : Tm) {z z' : Tm} (c : Step z z') :
      Sq (r2 (.appR (.S ⬝ x ⬝ y) c) (.s x y z'))
         (r3 (.s x y z) (.appL (y ⬝ z) (.appR x c)) (.appR (x ⬝ z') (.appR y c)))
  /-- Closure under the context `– u`. -/
  | ctxL (u : Tm) {t t' : Tm} {p q : Red t t'} :
      Sq p q → Sq (Red.mapAppL u p) (Red.mapAppL u q)
  /-- Closure under the context `t –`. -/
  | ctxR (t : Tm) {u u' : Tm} {p q : Red u u'} :
      Sq p q → Sq (Red.mapAppR t p) (Red.mapAppR t q)
  /-- Closure under pre- and post-composition. -/
  | whisker {t₀ t u u₁ : Tm} (p₀ : Red t₀ t) (p₁ : Red u u₁) {p q : Red t u} :
      Sq p q → Sq (p₀.comp (p.comp p₁)) (p₀.comp (q.comp p₁))

/-- **K5.** Permutation equivalence, as generated by the elementary squares. -/
def PermEq {t u : Tm} : Red t u → Red t u → Prop := Relation.EqvGen (@Sq t u)

/-- **K6.** On K-free sources, the weight respects permutation equivalence. -/
theorem wt_permEq {t u : Tm} (ht : KFree t) {p q : Red t u} :
    PermEq p q → Red.wt p = Red.wt q := by
  sorry

/-- **K7.** Nothing absorbs the loop at `Ω`: unavoidable divergence. -/
theorem not_absorbed {u : Tm} (h : Red Ω u) : ¬ PermEq (omegaLoop.comp h) h := by
  sorry

/-- **K8.** In `K a Ω`, the K-step absorbs the loop: avoidable divergence. -/
theorem absorbed (a : Tm) :
    PermEq ((Red.mapAppR (.K ⬝ a) omegaLoop).comp (r1 (.k a Ω))) (r1 (.k a Ω)) := by
  sorry

end FormalComputation.SKI
